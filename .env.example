# Karnataka ESCOM Environment Variables Template

# Django Configuration
SECRET_KEY=production-secret-key-change-in-deploy
DEBUG=True
ALLOWED_HOSTS=*

# MySQL Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=kspdb_fault_db
DB_USER=kspdb_user
DB_PASSWORD=kspdb_password
DB_HOST=db
DB_PORT=3306
USE_SQLITE=False

# AI Assistant Configuration
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# Ingestion Queue Parameters
INGEST_BATCH_SIZE=500
INGEST_MAX_BURST=5000
