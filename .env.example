# KSPDB Environment Configuration Example
# Copy this file to .env before starting local or containerized services.

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=development-only-secret-key-change-before-production
DEBUG=True
ALLOWED_HOSTS=*

# Server & Port Binding
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Polling & Refresh Rates (Seconds)
CONTROL_ROOM_POLL_INTERVAL=4
